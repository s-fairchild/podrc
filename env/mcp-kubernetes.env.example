# shellcheck shell=sh disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcp-quadlets/mcp-kubernetes.env (make install does
# this automatically if the destination doesn't already exist) and fill in
# real values. That file is untracked -- never commit a populated env file.

# Mounted as a podman secret (type mount)
# Update with the path assigned to KUBECONFIG_PODMAN_SECRET_TARGET in env/mcp-kubernetes-systemd.env
#
# Currently kubeconfig is passed as a cli argument based on KUBECONFIG_PODMAN_SECRET_TARGET
# so this is unused.
# KUBECONFIG=/home/mcp/.kube/config

# Example: Enforce TLS 1.3 minimum version (inbound + outbound)
# export TLS_MIN_VERSION="1.3"

# Example: Restrict TLS 1.2 cipher suites (inbound + outbound; TLS 1.3 ciphers are not configurable)
# export TLS_MIN_VERSION="1.2"
# export TLS_CIPHER_SUITES="TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384"
# export TLS_MIN_VERSION="1.3"

