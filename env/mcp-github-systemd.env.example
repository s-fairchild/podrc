# shellcheck shell=sh disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcp-quadlets/mcp-github-systemd.env (make install does this
# automatically if the destination doesn't already exist) and fill in real
# values. That file is untracked -- never commit a populated env file.

# This is the name of the podman secret containing the contents for GITHUB_PERSONAL_ACCESS_TOKEN
# Can be the podman secret name or ID
GITHUB_PERSONAL_ACCESS_TOKEN_PODMAN_SECRET="github-personal-access-token"
