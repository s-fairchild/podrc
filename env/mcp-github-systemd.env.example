# shellcheck shell=sh disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcpod/mcp-github-systemd.env (make install does this
# automatically if the destination doesn't already exist) and fill in real
# values. That file is untracked -- never commit a populated env file.

# This is the name of the podman secret containing the GitHub App's PEM
# private key (create with e.g. `podman secret create github-app-private-key
# ./your-app.private-key.pem`). Can be the podman secret name or ID.
GITHUB_APP_PRIVATE_KEY_PODMAN_SECRET="github-app-private-key"
PODMAN_LOG_LEVEL=info
