# Copy to $XDG_CONFIG_HOME/mcpod/kubernetes-mcp.toml (make install
# does this automatically if the destination doesn't already exist) and
# adjust as needed. Mounted read-only into the container by the
# Volume= line in kubernetes-mcp.container, at the path given by CONFIG
# in kubernetes-mcp-systemd.env.
#
# TODO(verify): schema not yet confirmed against the real image's
# --config handling -- see the TODO(verify) note atop
# kubernetes-mcp.container. Keys below mirror the CLI flags documented in
# kubernetes-mcp-systemd.env.example; drop any that the image doesn't
# actually support once verified.
#
#   * Reference: https://github.com/containers/kubernetes-mcp-server/blob/main/docs/configuration.md#drop-in-configuration

#############################
### Kubernetes Connection ###
#############################
#
# Reference: https://github.com/containers/kubernetes-mcp-server/blob/main/docs/configuration.md#kubernetes-connection

# Update this if your kubeconfig secret name differs
kubeconfig = "/run/secrets/kubernetes-mcp-kubeconfig"
cluster_provider_strategy = "kubeconfig"
