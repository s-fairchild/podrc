# Copy to $XDG_CONFIG_HOME/podrc/kubernetes-mcp.toml (make install
# does this automatically if the destination doesn't already exist) and
# adjust as needed. Mounted read-only into the container by the
# Volume= line in kubernetes-mcp.container, at the path given by CONFIG
# in kubernetes-mcp-systemd.env.
