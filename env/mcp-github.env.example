# shellcheck shell=sh disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcpod/mcp-github.env (make install does this
# automatically if the destination doesn't already exist) and fill in real
# values. That file is untracked -- never commit a populated env file.

GITHUB_TOOLSETS=repos,issues,pull_requests
GITHUB_READ_ONLY=1

# GitHub App auth (see docs/github-app-auth.md upstream). App ID and
# installation ID aren't secret; the private key is injected via podman
# secret instead -- see GITHUB_APP_PRIVATE_KEY_PODMAN_SECRET in
# mcp-github-systemd.env.example and the Secret= mount in
# mcp-github.container, whose target this path must match.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-key.pem
