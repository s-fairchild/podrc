# shellcheck shell=bash disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcpod/github-mcp-server.env (make install does this
# automatically if the destination doesn't already exist) and fill in real
# values. That file is untracked -- never commit a populated env file.

readonly GITHUB_TOOLSETS=repos,issues,pull_requests
readonly GITHUB_READ_ONLY=1

# GitHub App auth (see docs/github-app-auth.md upstream). The server signs
# its own JWT and exchanges it for an installation access token
# internally, refreshing it as needed -- App ID and installation ID are
# plain values, not secrets. Fill in your GitHub App's own values below.
readonly GITHUB_APP_ID="<your-github-app-id>"
readonly GITHUB_APP_INSTALLATION_ID="<your-github-app-installation-id>"

# The private key is the only sensitive value here, so it stays behind a
# podman secret instead of a plain value -- this is the name of that
# secret, not the key material itself. Create it yourself with:
#   podman secret create github-app-private-key ./your-app.pem
readonly GITHUB_APP_PEM_PODMAN_SECRET="github-app-private-key"

# Global podman options
readonly PODMAN_LOG_LEVEL="info"

# Default values. Can be set to change the image repository and/or tag.
# GITHUB_MCP_SERVER_STDIO_IMAGE_TAG="latest"
# GITHUB_MCP_SERVER_STDIO_REPOSITORY="ghcr.io/github/github-mcp-server"
