# shellcheck shell=sh disable=SC2034

# Copy to $XDG_CONFIG_HOME/mcp-quadlets/mcp-kubernetes.env (make install does
# this automatically if the destination doesn't already exist) and fill in
# real values. That file is untracked -- never commit a populated env file.

KUBECONFIG_PODMAN_SECRET_NAME="mcp-kubernetes-kubeconfig"
# Must be mounted and have read permissions within the container
KUBECONFIG_PODMAN_SECRET_TARGET=/home/mcp/.kube/config
