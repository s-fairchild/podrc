# GitHub MCP server container image.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/github-mcp-server.image
# Quadlet generates github-mcp-server-image.service from this file, which
# pulls the image on start. mcp-github.container depends on it via
# Image=github-mcp-server.image (Quadlet resolves the .image suffix to
# this unit and wires up the service dependency automatically).

[Image]
Image=ghcr.io/github/github-mcp-server:latest
Retry=10
RetryDelay=30s
TLSVerify=true
