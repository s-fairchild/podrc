# GitHub MCP server, run as a rootless podman user service.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/mcp-github.container
# Quadlet generates mcp-github.service from this file.
#
# TODO(verify): github-mcp-server's stdio transport is what most MCP
# clients spawn on demand (`docker run -i ...`). Running it as a
# long-lived systemd unit only makes sense in a persistent HTTP/SSE
# transport mode. Confirm the current image's exact flag for this
# (e.g. `--transport sse --host 0.0.0.0 --port 8081`, or an
# equivalent env var) against `podman run --rm ghcr.io/github/github-mcp-server
# --help` before relying on this in production, and update Exec=
# below accordingly. See README.md "Transport caveat". The image
# itself is pulled by github-mcp-server.image, not by this file.

[Unit]
Description=GitHub MCP Server
After=network-online.target mcp-network.service
Requires=mcp-network.service
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/mcp-quadlets/mcp-github-systemd.env
ExecStartPre=/bin/sh -c '[ -n "${GITHUB_PERSONAL_ACCESS_TOKEN}" ] || { echo "GITHUB_PERSONAL_ACCESS_TOKEN is not set" >&2; exit 1; }'
ExecStartPre=/bin/sh -c "podman secret exists ${GITHUB_PERSONAL_ACCESS_TOKEN_PODMAN_SECRET}"

[Container]
Image=github-mcp-server.image
ContainerName=mcp-github
Network=mcp.network
PublishPort=127.0.0.1:8081:8081
Secret=${GITHUB_PERSONAL_ACCESS_TOKEN_PODMAN_SECRET},type=env,target=GITHUB_PERSONAL_ACCESS_TOKEN
EnvironmentFile=-%h/.config/mcp-quadlets/mcp-github.env
Exec=--transport sse \
     --host 0.0.0.0 \
     --port 8081
AutoUpdate=registry
HealthCmd=CMD-SHELL curl -sf http://localhost:8081/healthz || exit 1
HealthInterval=30s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=default.target
