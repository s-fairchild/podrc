# Test fixture standing in for a filled-in
# ~/.config/podrc/github-mcp-server.env. github-mcp-server-stdio sources
# this file directly (not via `podman run --env-file=`), so GITHUB_APP_ID,
# GITHUB_APP_INSTALLATION_ID, and GITHUB_APP_PEM_PODMAN_SECRET here are the
# values the script actually reads out of it -- GITHUB_TOOLSETS and
# GITHUB_READ_ONLY are unused fixture filler, matching the real template's
# shape.
GITHUB_TOOLSETS=repos,issues,pull_requests
GITHUB_READ_ONLY=1
GITHUB_APP_ID="12345"
GITHUB_APP_INSTALLATION_ID="67890"
GITHUB_APP_PEM_PODMAN_SECRET="test-github-app-private-key"
