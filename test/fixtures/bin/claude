#!/usr/bin/env bash
# Fake `claude` CLI for tests: only implements the `mcp add`/`mcp get`/
# `mcp remove` subset install-claude-mcp.sh/uninstall-claude-mcp.sh use,
# tracking registered server names as empty files under
# CLAUDE_STUB_STATE_DIR instead of touching the real ~/.claude.json.
# Every invocation is also logged to CLAUDE_STUB_LOG for assertions.
#
# The `add` flag parser below only needs to understand the forms this
# repo's scripts actually pass (--transport/-t, --scope/-s each take one
# value; -- ends flags); it isn't a full re-implementation of `claude
# mcp add`'s option grammar.

set -euo pipefail

: "${CLAUDE_STUB_LOG:?CLAUDE_STUB_LOG must be set}"
: "${CLAUDE_STUB_STATE_DIR:?CLAUDE_STUB_STATE_DIR must be set}"
mkdir -p "${CLAUDE_STUB_STATE_DIR}"

printf '%s\n' "$*" >>"${CLAUDE_STUB_LOG}"

if [[ "${1:-}" != "mcp" ]]; then
  echo "claude stub: unsupported command: $*" >&2
  exit 1
fi
subcommand="${2:-}"
shift 2 || true

case "${subcommand}" in
  add)
    name=""
    scope="local"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --transport | -t | --client-id | --callback-port) shift 2 ;;
        --scope | -s)
          scope="$2"
          shift 2
          ;;
        -e | --env | -H | --header) shift 2 ;;
        --) shift ;;
        *)
          if [[ -z "${name}" ]]; then
            name="$1"
          fi
          shift
          ;;
      esac
    done

    state_file="${CLAUDE_STUB_STATE_DIR}/${name}"
    if [[ -e "${state_file}" ]]; then
      echo "MCP server ${name} already exists in ${scope} config" >&2
      exit 1
    fi
    echo "${scope}" >"${state_file}"
    echo "Added MCP server ${name}"
    ;;
  get)
    name="$1"
    if [[ ! -e "${CLAUDE_STUB_STATE_DIR}/${name}" ]]; then
      echo "No MCP server found with name: ${name}" >&2
      exit 1
    fi
    ;;
  remove)
    name="$1"
    if [[ ! -e "${CLAUDE_STUB_STATE_DIR}/${name}" ]]; then
      echo "No MCP server found with name: ${name}" >&2
      exit 1
    fi
    rm -f "${CLAUDE_STUB_STATE_DIR}/${name}"
    ;;
  *)
    echo "claude stub: unsupported mcp subcommand: ${subcommand}" >&2
    exit 1
    ;;
esac
