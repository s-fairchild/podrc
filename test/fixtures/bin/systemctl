#!/usr/bin/env bash
# Fake systemctl for tests: records invocations instead of touching the
# real user systemd manager. Point SYSTEMCTL_STUB_LOG at a file before
# putting this directory ahead of the real systemctl on PATH.

set -euo pipefail

: "${SYSTEMCTL_STUB_LOG:?SYSTEMCTL_STUB_LOG must be set}"
printf '%s\n' "$*" >>"${SYSTEMCTL_STUB_LOG}"
exit 0
