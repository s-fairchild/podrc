#!/usr/bin/env bash
# Create or replace the podman secret kubernetes-mcp.container mounts as
# the cluster kubeconfig (see KUBECONFIG_PODMAN_SECRET_NAME in
# kubernetes-mcp-systemd.env.example), from the contents of
# ~/.kube/config.
#
# Deliberately does not source hack/common.sh: this is a standalone
# home/bin/ entry point, installed and run on a machine that may not have
# this repo checked out.
#
# Usage: kubernetes-mcp-kubeconfig-secret

set -o errexit \
  -o nounset \
  -o pipefail

readonly KUBECONFIG_SRC="${HOME}/.kube/config"
readonly SECRET_NAME_DEFAULT="kubernetes-mcp-kubeconfig"
readonly SECRET_NAME="${KUBECONFIG_PODMAN_SECRET_NAME:-$SECRET_NAME_DEFAULT}"

#######################################
# Writes KUBECONFIG_SRC's contents to the SECRET_NAME podman secret,
# replacing it if it already exists.
# Globals:
#   KUBECONFIG_SRC
#   SECRET_NAME
# Outputs:
#   Writes status to stderr, or an error if KUBECONFIG_SRC is missing.
# Returns:
#   1 if KUBECONFIG_SRC doesn't exist.
#######################################
main() {
  if [[ ! -f "${KUBECONFIG_SRC}" ]]; then
    echo "kubernetes-mcp-kubeconfig-secret: ${KUBECONFIG_SRC} not found" >&2
    exit 1
  fi

  local -ar podman_secret_create_options=(
    --replace
    --label type=kubeconfig
    --label app=kubernetes-mcp-server
    --label managed-by=podrc
  )

  podman secret \
    create \
    "${podman_secret_create_options[@]}" \
    "${SECRET_NAME}" \
    "${KUBECONFIG_SRC}"

  echo "kubernetes-mcp-kubeconfig-secret: wrote ${SECRET_NAME} from ${KUBECONFIG_SRC}" >&2
}

main "$@"
