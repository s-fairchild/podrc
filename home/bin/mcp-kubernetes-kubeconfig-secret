#!/usr/bin/env bash
# Create or replace the podman secret mcp-kubernetes.container mounts as
# the cluster kubeconfig (see KUBECONFIG_PODMAN_SECRET_NAME in
# mcp-kubernetes-systemd.env.example), from the contents of
# ~/.kube/config.
#
# Deliberately does not source hack/common.sh: this is a standalone
# home/bin/ entry point, installed and run on a machine that may not have
# this repo checked out.
#
# Usage: mcp-kubernetes-kubeconfig-secret

set -o errexit \
    -o nounset \
    -o pipefail

readonly KUBECONFIG_SRC="${HOME}/.kube/config"
readonly SECRET_NAME_DEFAULT="mcp-kubernetes-kubeconfig"
readonly SECRET_NAME="${KUBECONFIG_PODMAN_SECRET_NAME:-$SECRET_NAME_DEFAULT}"

main() {
  if [[ ! -f "${KUBECONFIG_SRC}" ]]; then
    echo "mcp-kubernetes-kubeconfig-secret: ${KUBECONFIG_SRC} not found" >&2
    exit 1
  fi

  local -ar podman_secret_create_options=(
    --replace
    --label type=kubeconfig
    --label app=mcp-kubernetes-server
    --label managed-by=mcpod
  )

  podman secret \
         create \
         "${podman_secret_create_options[@]}" \
         "${SECRET_NAME}" \
         "${KUBECONFIG_SRC}"

  echo "mcp-kubernetes-kubeconfig-secret: wrote ${SECRET_NAME} from ${KUBECONFIG_SRC}" >&2
}

main "$@"
