#!/usr/bin/env bash
# Run containerized butane instead of requiring it on the host.
#
# TODO script creating ssh keys as podman secrets, mount them as secret files
# TODOs
#     * Mount luks_keys are podman secrets
#     * Mount ssh keys are podman secrets
#
# Usage: butane <args...>

set -euo pipefail

#######################################
# Runs butane via `podman run`, mounting the current directory read-only
# at /data (as the invoking user, via --userns=keep-id) and forwarding all
# arguments to the container's butane entrypoint.
# Arguments:
#   All arguments are forwarded to the containerized butane.
# Globals:
#   PODMAN_LOG_LEVEL: optional; forwarded as `podman run --log-level`.
# Outputs:
#   Writes the containerized butane's stdout/stderr.
# Returns:
#   The containerized butane's exit status.
#######################################
butane() {
  local -r image="quay.io/coreos/butane:release"

  local -a podman_run_options=(
    "-i"
    "--rm"
    "--pull=missing"
    "--userns=keep-id"
    "--security-opt=label=disable"
    "-v=${PWD}:/data:ro,rshared"
    "--workdir=/data"
  )

  if [[ -n "${PODMAN_LOG_LEVEL:-}" ]]; then
    podman_run_options+=("--log-level=${PODMAN_LOG_LEVEL}")
  fi

  podman run \
    "${podman_run_options[@]}" \
    "$image" \
    "$@"
}

butane "$@"
