#!/usr/bin/env bash
# Spawn one github-mcp-server container per MCP connection over stdio.
# Point an MCP client's stdio "command" directly at this script -- it
# execs into `podman run -i --rm`, so the container's stdin/stdout become
# the MCP transport and there is no long-lived service to attach to.
#
# Deliberately does not source common.sh/init_logging: bash-logger sends
# INFO and below to stdout by default, and once podman starts, stdout is
# the MCP protocol channel -- a stray log line there would corrupt it.
# Diagnostics below go straight to stderr instead.
#
# Usage: home/bin/mcp-github-stdio

set -euo pipefail

readonly ENV_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/mcpod"
readonly CONTAINER_ENV_FILE="${ENV_DIR}/mcp-github.env"
readonly SYSTEMD_ENV_FILE="${ENV_DIR}/mcp-github-systemd.env"

declare MCP_GITHUB_STDIO_CONTAINER_IMAGE_TAG="${MCP_GITHUB_STDIO_CONTAINER_IMAGE_TAG:-latest}"
declare -r MCP_GITHUB_STDIO_CONTAINER_IMAGE="ghcr.io/github/github-mcp-server:${MCP_GITHUB_STDIO_CONTAINER_IMAGE_TAG}"

main() {
  local secret_name

  for f in "${CONTAINER_ENV_FILE}" "${SYSTEMD_ENV_FILE}"; do
    if [[ ! -f "${f}" ]]; then
      echo "mcp-github-stdio: missing ${f} (run 'make install' first)" >&2
      exit 1
    fi
  done

  # shellcheck source=/dev/null
  . "${SYSTEMD_ENV_FILE}"
  secret_name="${GITHUB_APP_PRIVATE_KEY_PODMAN_SECRET:?GITHUB_APP_PRIVATE_KEY_PODMAN_SECRET is not set in ${SYSTEMD_ENV_FILE}}"

  local -ar podman_run_options=(
    "-i"
    "--rm"
    "--secret=${secret_name},type=mount,target=/run/secrets/github-app-key.pem"
    "--env-file=${CONTAINER_ENV_FILE}"
  )

  exec podman run "${podman_run_options[@]}" "${MCP_GITHUB_STDIO_CONTAINER_IMAGE}" \
    stdio --enable-command-logging
}

main "$@"
