# Kubernetes MCP server, run as a rootless podman user service.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/kubernetes-mcp-server.container
# Quadlet generates kubernetes-mcp-server.service from this file.
#
# The container needs read access to a kubeconfig for whichever cluster
# it should manage. Point KUBECONFIG (in kubernetes-mcp.env) at the
# in-container path below, and swap the source path in Volume= for your
# real kubeconfig -- this repo's sibling `titan` cluster kubeconfig, a
# kubeconfig scoped to a service account, etc.
#
# The optional config directory (a main config.toml plus ordered
# conf.d/*.toml drop-ins) is mounted the same way, as a whole directory:
# the Volume= line below binds
# $XDG_CONFIG_HOME/podrc/etc/kubernetes-mcp-server read-only at
# /etc/kubernetes-mcp-server in the container. `make install` writes that
# source directory's contents from env/etc/kubernetes-mcp-server/*.example
# (skipping any file that already exists, same as every other env
# template) -- edit them directly under $XDG_CONFIG_HOME/podrc/ after
# install; they're never overwritten by a reinstall. If you don't need
# this, drop the --config/--config-dir flags and the Volume= line below,
# and leave that installed directory empty.

[Unit]
Description=Kubernetes MCP Server
After=network-online.target

[Service]
EnvironmentFile=%h/.config/podrc/kubernetes-mcp-systemd.env
ExecStartPre=/bin/sh -c '[[ -n "${KUBECONFIG_PODMAN_SECRET_NAME}" ]] || { echo "KUBECONFIG_PODMAN_SECRET_NAME is not set" >&2; exit 1; }'
ExecStartPre=/bin/sh -c 'podman secret exists ${KUBECONFIG_PODMAN_SECRET_NAME} || { echo "podman secret ${KUBECONFIG_PODMAN_SECRET_NAME} does not exist." >&2; exit 1; }'

[Container]
Image=kubernetes-mcp-server.image
ContainerName=%N
Label=app.kubernetes.io/name=kubernetes-mcp-server
Label=app.kubernetes.io/component=mcp-server
Label=app.kubernetes.io/part-of=podrc
Label=app.kubernetes.io/managed-by=quadlet
Label=org.opencontainers.image.source=https://github.com/s-fairchild/podrc
Network=mcp.network
PublishPort=127.0.0.1:8081:8081
Secret=${KUBECONFIG_PODMAN_SECRET_NAME},type=mount,uid=65532,gid=65532,mode=0400
Volume=%h/.config/podrc/etc/kubernetes-mcp-server:/etc/kubernetes-mcp-server:ro,Z,U
EnvironmentFile=%h/.config/podrc/kubernetes-mcp.env
Exec=--config /etc/kubernetes-mcp-server/config.toml
# https://github.com/containers/kubernetes-mcp-server/blob/main/docs/configuration.md#dynamic-configuration-reload
ReloadSignal=SIGHUP
AutoUpdate=registry
HealthCmd=CMD-SHELL curl -sf http://localhost:8081/healthz || exit 1
HealthInterval=30s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=default.target
