# Podman network matching a local k3d cluster's own network, for
# containers that need to reach it directly (e.g. a Kubernetes MCP
# server pointed at k3d instead of a remote cluster).
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/k3d.network
# Quadlet generates k3d-network.service from this file.
# kubernetes-mcp-server.container depends on it via Network=k3d.network.

[Unit]
Description=Shared network for MCP servers

[Service]
EnvironmentFile=-%h/.config/podrc/%N-systemd.env
EnvironmentFile=%h/.config/podrc/mcp-podman-global-systemd.env

[Network]
NetworkName=k3d
InterfaceName=k3d0
IPAMDriver=host-local
Subnet=10.81.0.0/28
IPRange=10.81.0.0/28
Gateway=10.81.0.1
DNS=10.81.0.1
IPv6=false
NetworkDeleteOnStop=true
Label=claude
Label=claude-code
Label=mcp-servers
