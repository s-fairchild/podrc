# Shared podman network for MCP server containers.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/mcp.network
# Quadlet generates mcp-network.service from this file; the .container
# units below depend on it via Network=mcp.network.

[Unit]
Description=Shared network for MCP servers

[Service]
EnvironmentFile=-%h/.config/podrc/%N-systemd.env
EnvironmentFile=%h/.config/podrc/mcp-podman-global-systemd.env
ExecStartPre=/bin/sh -c '[ -n "${PODMAN_LOG_LEVEL}" ] || { echo "PODMAN_LOG_LEVEL is not set" >&2; exit 1; }'

[Network]
NetworkName=mcp
InterfaceName=mcp0
# Just incase InterfaceName doesn't work
# Options=com.docker.network.bridge.name=mcp0
IPAMDriver=host-local
Subnet=10.80.0.0/28
IPRange=10.80.0.0/28
# IPRange=10.80.0.1-10.80.0.14
GlobalArgs=--log-level=${PODMAN_LOG_LEVEL}
Gateway=10.80.0.1
DNS=10.80.0.1
IPv6=false
NetworkDeleteOnStop=true
Label=claude
Label=claude-code
Label=mcp-servers
