# GitHub MCP server container image.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/github-mcp-server.image
# Quadlet generates github-mcp-server-image.service from this file, which
# pulls/refreshes the image on start. No .container unit references this
# via Image= -- github-mcp-server only supports the stdio transport (see
# README.md "Transport caveat"), which runs per-connection via
# home/bin/mcp-github-stdio.sh's own `podman run`, not a Quadlet-managed
# container. This unit exists solely to keep the image pulled/current
# independent of that; enable github-mcp-server-image.service (or its
# timer, if you add one) if you want that.

[Image]
Image=ghcr.io/github/github-mcp-server:latest
Retry=10
RetryDelay=30s
TLSVerify=true
