# Kubernetes MCP server, run as a rootless podman user service.
#
# Installed to $XDG_CONFIG_HOME/containers/systemd/mcp-kubernetes.container
# Quadlet generates mcp-kubernetes.service from this file.
#
# The container needs read access to a kubeconfig for whichever cluster
# it should manage. Point KUBECONFIG (in mcp-kubernetes.env) at the
# in-container path below, and swap the source path in Volume= for your
# real kubeconfig -- this repo's sibling `titan` cluster kubeconfig, a
# kubeconfig scoped to a service account, etc.
#
# The optional config directory (a main config.toml plus ordered
# conf.d/*.toml drop-ins) is mounted the same way, as a whole directory:
# the Volume= line below binds
# $XDG_CONFIG_HOME/mcpod/etc/mcp-kubernetes-server read-only at
# /etc/kubernetes-mcp-server in the container. `make install` populates
# that source directory from config/mcpod/etc/mcp-kubernetes-server/
# -- real, untracked files you edit directly in your checkout (see
# config/mcpod/.gitignore); every install mirrors its current
# contents, so edits there are picked up on the next `make install`. If
# you don't need this, drop the --config/--config-dir flags and the
# Volume= line below, and leave that source directory empty.

[Unit]
Description=Kubernetes MCP Server
After=network-online.target mcp-network.service
Requires=mcp-network.service
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/mcpod/mcp-kubernetes-systemd.env
ExecStartPre=/bin/sh -c '[ -n "${KUBECONFIG_PODMAN_SECRET_NAME}" ] || { echo "KUBECONFIG_PODMAN_SECRET_NAME is not set" >&2; exit 1; }'
ExecStartPre=/bin/sh -c '[ -n "${KUBECONFIG_PODMAN_SECRET_TARGET}" ] || { echo "KUBECONFIG_PODMAN_SECRET_TARGET is not set" >&2; exit 1; }'
ExecStartPre=/bin/sh -c 'podman secret exists ${KUBECONFIG_PODMAN_SECRET_NAME} || { echo "podman secret ${KUBECONFIG_PODMAN_SECRET_NAME} does not exist." >&2; exit 1; }'
ExecStartPre=/bin/sh -c 'podman secret exists ${KUBECONFIG_PODMAN_SECRET_TARGET} || { echo "podman secret ${KUBECONFIG_PODMAN_SECRET_TARGET} does not exist." >&2; exit 1; }'

[Container]
Image=kubernetes-mcp-server.image
ContainerName=%N
Network=mcp.network
PublishPort=127.0.0.1:8082:8082
Secret=${KUBECONFIG_PODMAN_SECRET_NAME},type=mount,target=${KUBECONFIG_PODMAN_SECRET_TARGET},uid=65532,gid=65532,mode=0400
Volume=%h/.config/mcpod/etc/mcp-kubernetes-server:/etc/kubernetes-mcp-server:ro,Z
EnvironmentFile=%h/.config/mcpod/mcp-kubernetes.env
Exec=--cluster-provider kubeconfig \
     --config /etc/kubernetes-mcp-server/config.toml \
     --log-file stderr \
     --log-level ${LOG_LEVEL}
AutoUpdate=registry
HealthCmd=CMD-SHELL curl -sf http://localhost:8082/healthz || exit 1
HealthInterval=30s
HealthRetries=3

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=30

[Install]
WantedBy=default.target
